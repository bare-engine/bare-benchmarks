{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "lib": ["ES2022", "DOM"],
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src",
        "benchmarks"
    ],
    "exclude": [
        "node_modules"
    ]
}
