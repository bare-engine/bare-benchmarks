{
    "name": "bare-benchmarks",
    "version": "1.2.1",
    "scripts": {
        "start": "npm run build && npm run preview",
        "build": "node scripts/build.mjs",
        "preview": "node scripts/serve.mjs",
        "dev": "vite --config vite.dashboard.config.mjs --open",
        "dev:bare": "cd benchmarks/startup/bare && vite --mode development",
        "dev:bare:render": "cd benchmarks/render/bare && vite --mode development",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bare-engine/BareBenchmark.git"
    },
    "author": "Jeroen Wimmers",
    "license": "MIT",
    "devDependencies": {
        "@assetpack/core": "^1.7.0",
        "@playwright/test": "^1.63.0",
        "typescript": "5.9.3",
        "vite": "^6.3.5"
    },
    "dependencies": {
        "bare-engine": "github:BareEngine/BareEngine",
        "excalibur": "0.32.0",
        "kaplay": "3001.0.19",
        "littlejsengine": "1.18.29",
        "melonjs": "20.6.0",
        "phaser": "4.2.1",
        "pixi.js": "8.21.0"
    }
}
